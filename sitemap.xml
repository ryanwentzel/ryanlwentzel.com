---
sitemap:
    exclude: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>{{ site.url | absolute_url }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <priority>1.0</priority>
        <changefreq>weekly</changefreq>
    </url>
    <url>
        <loc>{{ "favicon.ico" | absolute_url }}/</loc>
    </url>
    <url>
        <loc>{{ site.url }}{% link _pages/about.md %}</loc>
        <priority>1.0</priority>
        <changefreq>yearly</changefreq>
    </url>
    <url>
        <loc>{{ site.data.archive.podcast | absolute_url }}</loc>
        <lastmod>{% include sitemap/collection-lastmod.html collection=site.sermons %}</lastmod>
        <priority>1.0</priority>
        <changefreq>weekly</changefreq>
    </url>
    <url>
        <loc>{{ site.url }}{% link _pages/newsletter.md %}</loc>
        <lastmod>{% include sitemap/collection-lastmod.html collection=site.newsletter %}</lastmod>
        <priority>1.0</priority>
        <changefreq>monthly</changefreq>
    </url>
    <url>
        <loc>{{ site.data.archive.commonplace | absolute_url }}</loc>
        <lastmod>{% include sitemap/collection-lastmod.html collection=site.commonplace %}</lastmod>
        <priority>0.5</priority>
        <changefreq>weekly</changefreq>
    </url>
    <url>
        <loc>{{ site.data.archive.prayers | absolute_url }}</loc>
        <lastmod>{% include sitemap/collection-lastmod.html collection=site.prayers %}</lastmod>
        <priority>0.5</priority>
        <changefreq>weekly</changefreq>
    </url>
    <url>
        <loc>{{ site.data.archive.articles | absolute_url }}</loc>
        <lastmod>{% include sitemap/collection-lastmod.html collection=site.articles %}</lastmod>
        <priority>0.5</priority>
        <changefreq>monthly</changefreq>
    </url>
    <url>
        <loc>{{ site.data.archive.field_notes | absolute_url }}</loc>
        <lastmod>{% include sitemap/collection-lastmod.html collection=site.fieldnotes %}</lastmod>
        <priority>0.5</priority>
        <changefreq>monthly</changefreq>
    </url>
{%- include sitemap/collection.html collection=site.newsletter %}
{%- include sitemap/collection.html collection=site.sermons %}
{%- include sitemap/collection.html collection=site.prayers %}
{%- include sitemap/collection.html collection=site.articles %}
{%- include sitemap/collection.html collection=site.fieldnotes %}
{%- include sitemap/collection.html collection=site.playlists %}
{%- include sitemap/collection.html collection=site.resources %}
{%- include sitemap/collection.html collection=site.commonplace %}
{%- include sitemap/collection.html collection=site.photos %}
</urlset>
