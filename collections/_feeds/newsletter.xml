---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.data.newsletter.title }}</title>
  <subtitle>{{ site.data.newsletter.subtitle }}</subtitle>
  <rights>{{ site.data.newsletter.rights.statement }} {{ site.data.newsletter.rights.start_year }}–{{ "now" | date: "%Y" }}. All rights reserved.</rights>
  <id>{{ '/' | absolute_url }}</id>
  <link href="{{ page.permalink | absolute_url }}" rel="self"/>
  <link href="{{ '/' | absolute_url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <generator>Jekyll</generator>
  <author>
    <name>{{ site.data.profile.name }}</name>
    <email>{{ site.data.profile.email }}</email>
    <uri>{{ '/' | absolute_url }}</uri>
  </author>
  <icon>{{ "favicon-32x32.png" | absolute_url }}</icon>
  {%- for item in site.newsletter limit:1 -%}
  <entry>
    <title>{{ item.title | xml_escape }}</title>
    <link href="{{ item.url | absolute_url }}"/>
    <published>{{ item.date | date_to_xmlschema }}</published>
    <updated>{{ item.date | date_to_xmlschema }}</updated>
    <id>{{ item.url | absolute_url }}</id>
    <content type="html"><![CDATA[
    {%- if item.img -%}
    <p><img src="{{ item.img.url }}"></p>
    {%- endif -%}
    {{ item.content | markdownify }}]]></content>
    <author>
      <name>{{ site.data.profile.name }}</name>
      <email>{{ site.data.profile.email }}</email>
      <uri>{{ '/' | absolute_url }}</uri>
    </author>
  </entry>
  {%- endfor -%}
</feed>
