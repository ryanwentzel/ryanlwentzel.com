#!/bin/bash

cdn="https://d1yo597syf8yny.cloudfront.net/assets/img/content/"
collections_dir="$project_dir/collections"
podcasts_dir="$collections_dir/_sermons"

# create article
function article () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local suffix="${title_lower// /-}"
    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local articles_dir="$collections_dir/_articles"
    local filename="$articles_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
subtitle: $subtitle
description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
img: 
    url: $cdn
    alt:
published: false 
---


DELIMIT

code "$filename"
}

# create newsletter
function newsletter () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local suffix="${title_lower// /-}"
    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local newsletter_dir="$collections_dir/_newsletter"
    local filename="$newsletter_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
subtitle: $subtitle
description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
img: 
    url: $cdn
published: false 
---

DELIMIT

code "$filename"

}

# Create a new podcast episode
function podcast () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local suffix="${title_lower// /-}"
    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local filename="$podcasts_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
subtitle: $subtitle
description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
published: false
img:
    url: 
episode_id: 
---

DELIMIT

code "$filename"

}

# Create a new prayer
function prayer () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local name="${title_lower// /-}"
    local prayers_dir="$collections_dir/_prayers"
    local filename="$prayers_dir/$name.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
subtitle: $subtitle
description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
published: false
img:
    url: 
    alt:
series:
---

DELIMIT

code "$filename"

}

