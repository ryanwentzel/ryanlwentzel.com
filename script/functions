# Create a new podcast episode
function podcast () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local suffix="${title_lower// /-}"
    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local filename="$podcasts_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
subtitle: $subtitle
description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
published: false
img:
    alt: ""
    url: "$cdn"
    url_md: "$cdn"
    url_sm: "$cdn"
episode_id: 
---

DELIMIT

code "$filename"

}

# Create a new prayer
function prayer () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local suffix="${title_lower// /-}"
    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local prayers_dir="$collections_dir/_prayers"
    local filename="$prayers_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
subtitle: $subtitle
description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
published: false
img:
    url: $cdn
    alt:
series:
---

DELIMIT

code "$filename"

}

# create commonplace entry
function commonplace () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local suffix="${title_lower// /-}"
    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local commonplace_dir="$collections_dir/_commonplace"
    local filename="$commonplace_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
subtitle: $subtitle
description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
img:
    url_lg: "$cdn_base/assets/img/content/"
    url_md: "$cdn_base/assets/img/content/"
    url_sm: "$cdn_base/assets/img/content/"
    alt: ""
published: false 
---

DELIMIT

code "$filename"

}

# create photo entry
function photo () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local suffix="${title_lower// /-}"
    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local dest_dir="$collections_dir/_photos"
    local filename="$dest_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
seo_title: 
subtitle: $subtitle
description: 
seo_description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
img:
    url: "$cdn_photos"
    alt: ""
    url_sm: "$cdn_photos"
    caption:
    shutter_speed:
    aperture:
    iso:
    lens: 50 mm (EFS50mm f/1.4 USM)
    camera: Canon EOS 6D
    date:
    location: Escondido, California
published: false 
---

DELIMIT

code "$filename"

}

