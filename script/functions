    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local resource_dir="$collections_dir/_resources"
    local filename="$resource_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
layout: resource
