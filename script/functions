#!/bin/bash

cdn_base="https://cdn.ryanlwentzel.com"
cdn_photos="$cdn_base/assets/img/photos/"
cdn="https://cdn.ryanlwentzel.com/assets/img/content/"
collections_dir="$project_dir/collections"
podcasts_dir="$collections_dir/_sermons"

# create article
function article () {
    local title="${1}"
    local subtitle="${2}"
    local title_lower=$(echo $title | tr '[:upper:]' '[:lower:]')
    local suffix="${title_lower// /-}"
    local date=$(date +"%Y-%m-%d")
    local slug="$date-$suffix"
    local articles_dir="$collections_dir/_articles"
    local filename="$articles_dir/$slug.md"
    echo "Creating $filename"
    cat << DELIMIT > "$filename"
---
title: $title
subtitle: $subtitle
description: 
date: $(date +'%Y-%m-%d %H:%M:%S %z')
img: 
    url: $cdn
    alt:
published: false 
---


DELIMIT

code "$filename"
}

