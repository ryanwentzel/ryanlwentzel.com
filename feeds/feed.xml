---
layout:
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
 <title>{{ site.data.settings.basic_settings.site_title }}</title>
 <link href="{{ site.url }}/feeds/feed.xml" rel="self"/>
 <link href="{{ site.url }}/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{ site.url }}</id>
 <author>
   <name>{{ site.data.settings.basic_settings.site_author }}</name>
   <email>{{ site.author.email }}</email>
 </author>
 <icon>{{ site.baseurl }}/favicon.ico</icon>
{%- comment -%}hack for now to get prayers in the main feed{%- endcomment -%}
{%- assign sorted = site.prayers | sort: "date" -%}
{%- assign prayers = sorted | reverse -%}
 {%- for prayer in prayers limit:10 -%}
 <entry>
   <title>{{- prayer.title -}}</title>
   <link href="{{- site.url -}}{{- prayer.url -}}"/>
   <updated>{{- prayer.date | date_to_xmlschema -}}</updated>
   <id>{{- site.url -}}{{- prayer.id -}}</id>   
   {%- capture prayer_content -%}{% include prayer-preview.html prayer=prayer absolute_url=true -%}{%- endcapture -%}
   <content type="html">{{- prayer_content | xml_escape -}}</content>
 </entry>
 {%- endfor -%}
 {% for post in site.posts limit:10 %}
 <entry>
   <title>{{ post.title }}</title>
   <link href="{{ site.url }}{{ post.url }}"/>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>{{ site.url }}{{ post.id }}</id>
   <content type="html">{{ post.content | xml_escape }}</content>
 </entry>
 {% endfor %}
</feed>
