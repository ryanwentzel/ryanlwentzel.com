---
layout:
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
 <title>Microposts – {{ site.data.settings.basic_settings.site_title -}}</title>
 <link href="{{- page.url | absolute_url -}}" rel="self"/>
 <link href="{{- site.url -}}/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{- site.url -}}</id>
 <author>
   <name>{{- site.data.settings.basic_settings.site_author -}}</name>
 </author>
 <icon>{{ "favicon.ico" | absolute_url }}</icon>
{%- assign sorted = site.microposts | sort: "date" -%}
{%- assign posts = sorted | reverse -%}
 {%- for post in posts limit:10 -%}
 <entry>
   <title>{{- post.title -}}</title>
   <link href="{{- site.url -}}{{- post.url -}}"/>
   <updated>{{- post.date | date_to_xmlschema -}}</updated>
   <id>{{- site.url -}}{{- post.url -}}</id>   
   <content type="html">{{- post.content | xml_escape -}}</content>
 </entry>
 {%- endfor -%}
</feed>
