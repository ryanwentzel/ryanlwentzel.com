---
layout: none
published: false
---
[
    {%- assign sermons = site.sermons | reverse -%}
    {%- for sermon in sermons -%}
        {
            "title":        {{- sermon.title | jsonify }},
            "date":         {{- sermon.date | date_to_xmlschema | jsonify }},
            "url":          {{- sermon.url | relative_url | jsonify }},
            "absoluteUrl":  {{- sermon.url | absolute_url | jsonify }},
            "path":         {{- sermon.path | jsonify }},
            "shareImage":   {{- sermon.img.url_md | default: sermon.img.url | jsonify }},
            "description":  {{- sermon.seo_description | default: sermon.description | jsonify }}
        }
    {% unless forloop.last %},{% endunless %}
    {% endfor -%}
]
